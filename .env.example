# Host the dev server proxies `/api/*` to. The app itself always calls relative
# `/api/...` URLs, so this is the only place the backend host is configured in dev.
#
#   API_HOST=http://localhost:8080
#   API_HOST=http://localhost:8081
#   API_HOST=api.example.com          <- scheme is optional, http:// is added
API_HOST=http://localhost:8080
